#include "nvs_flash.h"
#include "esp_log.h"
#include "driver/gpio.h"
#include "driver/uart.h"
#include "nimble/nimble_port.h"
#include "nimble/nimble_port_freertos.h"
#include "host/ble_hs.h"
#include "host/ble_gap.h"
#include "host/ble_gatt.h"
#include "services/gap/ble_svc_gap.h"
#include "services/gatt/ble_svc_gatt.h"

#define LED_PIN 5 // Change this to your LED's GPIO pin number

#define UART_NUM UART_NUM_2
#define TXD_PIN (GPIO_NUM_17)
#define RXD_PIN (GPIO_NUM_16)
#define BUF_SIZE (1024)


static uint8_t ble_addr_type;

void ble_host_task(void *param) {
    nimble_port_run();  // Starts the BLE host loop
    nimble_port_freertos_deinit();
}

void ble_app_on_sync(void) {
    ble_hs_id_infer_auto(0, &ble_addr_type);

    struct ble_gap_adv_params adv_params = {
        .conn_mode = BLE_GAP_CONN_MODE_UND,
        .disc_mode = BLE_GAP_DISC_MODE_GEN,
    };

    ble_gap_adv_start(ble_addr_type, NULL, BLE_HS_FOREVER, &adv_params, NULL, NULL);
}

void app_main(void) {
    // Configure UART parameters
    uart_config_t uart_config = {
        .baud_rate = 9600,
        .data_bits = UART_DATA_8_BITS,
        .parity    = UART_PARITY_DISABLE,
        .stop_bits = UART_STOP_BITS_1,
        .flow_ctrl = UART_HW_FLOWCTRL_DISABLE
    };
    
    // Configure the LED pin
    // gpio_config_t io_conf = {
    //     .pin_bit_mask = (1ULL << LED_PIN), // Select the GPIO pin
    //     .mode = GPIO_MODE_OUTPUT,          // Set as output mode
    //     .pull_up_en = GPIO_PULLUP_DISABLE, // Disable pull-up
    //     .pull_down_en = GPIO_PULLDOWN_DISABLE, // Disable pull-down
    //     .intr_type = GPIO_INTR_DISABLE,    // Disable interrupts
    // };
    // gpio_config(&io_conf);

    // // 2. Turn the LED ON
    // printf("Turning LED ON...asdfasdfas\n");
    // gpio_set_level(LED_PIN, 1); // Set the level to HIGH (1) to turn the LED on


    // todo: When uncommenting the UART logic the execution doesnt trigger this printf or anything past it,
    //       it will turn the gpio pins on though
    printf("Loading uart drivers...\n\n");
    // Install UART driver and configure pins
    ESP_ERROR_CHECK(uart_driver_install(UART_NUM, BUF_SIZE * 2, 0, 0, NULL, 0));
    printf("Loading uart configs...\n\n");
    ESP_ERROR_CHECK(uart_param_config(UART_NUM, &uart_config));
    printf("Loading uart set pins...\n\n");
    ESP_ERROR_CHECK(uart_set_pin(UART_NUM, TXD_PIN, RXD_PIN, UART_PIN_NO_CHANGE, UART_PIN_NO_CHANGE));

    const char *data = "Hello from Master ESP32!\n";

    printf("starting uart serial comms...\n\n");
    while (1) {
        printf("writing to uart...");
        uart_write_bytes(UART_NUM, data, strlen(data));
        vTaskDelay(pdMS_TO_TICKS(1000));
    }

    // bluetooth
    // printf("Starting nimble bluetooth stack..");
    // ble_svc_gap_device_name_set("AnkTesting");
    // ESP_ERROR_CHECK(nvs_flash_init());
    // ESP_ERROR_CHECK(nimble_port_init());
    
    // ble_svc_gap_init();
    // ble_svc_gatt_init();
    
    // ble_hs_cfg.sync_cb = ble_app_on_sync;
    
    // nimble_port_freertos_init(ble_host_task);





}